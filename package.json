{
  "name": "spielwiese",
  "version": "1.24.0",
  "private": true,
  "description": "Lokales Live-Board für ein kleines Freunde-Turnier: Teams auslosen, Spiele & Regeln anzeigen, Punkte live tracken, tippen und Awards feiern — offline im Heim-WLAN.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "serve": "node scripts/serve.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "nuxt build && playwright test"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^9.5.4",
    "nuxt": "^3.15.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.7.5",
    "@playwright/test": "^1.62.1",
    "@types/qrcode": "^1.5.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  },
  "packageManager": "pnpm@11.4.0"
}
